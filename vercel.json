{
  "version": 2,
  "builds": [
    { "src": "api/webhook.js", "use": "@vercel/node" },
    { "src": "cron/reminders.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "api/webhook.js" },
    { "src": "/cron/reminders", "dest": "cron/reminders.js" }
  ],
  "crons": [
    { "path": "/cron/reminders", "schedule": "0 12 * * *" }
  ]
}